# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Path to the q binary on your machine (run: which q)
QBIN=/usr/local/bin/q

# Directory containing q.k — usually the same folder as the q binary,
# or the value of $QHOME if set (run: echo $QHOME)
QHOME=/usr/local/bin

# Place your license file at: ${QHOME}/kc.lic
# (docker-compose mounts ${QHOME}/kc.lic into the kdb container)
