# Copy this file to .env and fill in the values:
#   cp .env.example .env

# Path to the q binary on your machine (run: which q)
QBIN=/usr/local/bin/q

# Directory containing q.k — usually the same folder as the q binary,
# or the value of $QHOME if set (run: echo $QHOME)
QHOME=/usr/local/bin

# Full path to your kdb+ license file kc.lic
# Free personal license: https://kx.com/download → Personal Edition
QLIC_FILE=~/.kdb/kc.lic
